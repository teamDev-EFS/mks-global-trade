PORT=3001
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/mks-global-trade
JWT_SECRET=change-me-to-a-long-random-string-in-production
JWT_EXPIRES_IN=7d

# Comma-separated browser origins allowed by CORS (no trailing slashes).
# Production: your Netlify custom domains. Local: add Vite ports for dev.
FRONTEND_URL=https://www.mskglobaltrade.com,https://mskglobaltrade.com,http://localhost:5173,http://localhost:5174

# Used only by `npm run seed` / `npm run create-admin`
# After changing these, run from backend: npm run seed  OR  node src/seed/createAdmin.js
ADMIN_DEFAULT_EMAIL=operations@mskglobaltrade.com
ADMIN_DEFAULT_PASSWORD=MskVijay452010!

# --- Vercel (this backend only) ---
# Git: Root Directory = `backend`  |  Framework: Other / Express is fine
# Build Command: (leave empty)  |  Output: N/A — serverless uses backend/api/index.js + backend/vercel.json
#
# In Vercel → Project → Settings → Environment Variables, set for Production (and Preview if you use it):
#   NODE_ENV=production
#   MONGODB_URI=<MongoDB Atlas connection string>
#   JWT_SECRET=<at least 32 random characters — required in production>
#   JWT_EXPIRES_IN=7d
#   FRONTEND_URL=https://your-site.netlify.app,https://www.yourdomain.com
#     (comma-separated, NO trailing slashes — must match the browser origin of your frontend exactly)
#
# Remove any placeholder vars (e.g. EXAMPLE_*). PORT is ignored on Vercel.
# After deploy, set the frontend VITE_API_URL to your Vercel URL, e.g. https://mks-global-trade-api.vercel.app
#
# Atlas: Network Access must allow Vercel (often 0.0.0.0/0 for serverless egress).
