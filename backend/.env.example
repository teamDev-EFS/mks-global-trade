PORT=3001
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/mks-global-trade
JWT_SECRET=change-me-to-a-long-random-string-in-production
JWT_EXPIRES_IN=7d

# Comma-separated browser origins allowed by CORS (no trailing slashes).
# Production: your Netlify custom domains. Local: add Vite ports for dev.
FRONTEND_URL=https://www.mskglobaltrade.com,https://mskglobaltrade.com,http://localhost:5173,http://localhost:5174

# Used only by `npm run seed` / `npm run create-admin`
# After changing these, run from backend: npm run seed  OR  node src/seed/createAdmin.js
ADMIN_DEFAULT_EMAIL=operations@mskglobaltrade.com
ADMIN_DEFAULT_PASSWORD=MskVijay452010!

# --- Vercel (backend) ---
# Set these in Vercel → Project → Settings → Environment Variables (Production + Preview):
#   NODE_ENV=production
#   MONGODB_URI=<Atlas connection string>
#   JWT_SECRET=<32+ random chars>
#   FRONTEND_URL=https://your-app.netlify.app,https://www.yourdomain.com
# Optional: PORT is ignored on Vercel (serverless).
#
# Atlas: allow 0.0.0.0/0 for IP access OR use a fixed egress solution — Vercel uses dynamic IPs.
