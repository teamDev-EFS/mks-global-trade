# Frontend (Vite) — copy to `.env` for local overrides.
#
# Local dev: leave VITE_API_URL empty — `/api` is proxied to the backend (vite.config.ts).
#
# Netlify production:
#   Set in Site settings → Environment variables (must be present at build time):
#   VITE_API_URL=https://YOUR-PROJECT.vercel.app
#   (no trailing slash; this is your Vercel backend deployment URL)
#
VITE_API_URL=
