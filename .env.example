# Public site URL (no trailing slash) — used for canonical URLs, sitemap, Open Graph.
# Set in Netlify/Vercel/hosting env and rebuild.
VITE_SITE_URL=https://www.mskglobaltrade.com

# Google Analytics 4 — Measurement ID (G-XXXXXXXXXX). Optional.
VITE_GA_MEASUREMENT_ID=

# Google Search Console verification (content value from meta tag). Optional.
VITE_GOOGLE_SITE_VERIFICATION=

# Backend API base URL (no trailing slash).
# Local dev: leave unset or comment out — the Vite dev server proxies /api → http://localhost:5100 (run backend: cd backend && npm run dev).
# Production (Netlify): set to your deployed API origin, e.g. https://your-api.vercel.app
# VITE_API_URL=https://your-api.example.com
